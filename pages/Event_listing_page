	function loadEvents(category = '', sort = '',date = '',location = '') {
    var url = '../php/event_list_php.php';
    var params = [];

    if (category) params.push('category=' + encodeURIComponent(category));
    if (sort) params.push('sort=' + encodeURIComponent(sort));

    if (params.length > 0) {
        url += '?' + params.join('&');
    }

    fetch(url)
        .then(response => response.text())
        .then(html => {
            document.querySelector('.events').innerHTML = html;
        })
        .catch(error => console.error('Error fetching events:', error));
}

// Load all events on page load
document.addEventListener('DOMContentLoaded', function() {
    loadEvents(); // load all
});

// Category filter
document.getElementById('category-filter').addEventListener('change', function() {
    loadEvents(this.value);
});

// Sort buttons
document.getElementById('a-z').addEventListener('click', function() {
    loadEvents('', 'a-z');
});
document.getElementById('date').addEventListener('click', function() {
    loadEvents('', 'date');
});
document.getElementById('pop').addEventListener('click', function() {
    loadEvents('', 'pop');
});

